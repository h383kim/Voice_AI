# STT (faster-whisper)
STT_MODEL_NAME=Systran/faster-whisper-small.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# LLM (Ollama HTTP API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Model for the action-vs-chat router pre-check; set to a smaller model (e.g.
# llama3.2:1b) to reduce per-turn latency. Defaults to OLLAMA_MODEL.
ROUTER_MODEL=llama3.2:3b

# TTS (piper-tts pip package; only the voice model is needed)
PIPER_VOICE_MODEL=./models/piper/en_US-lessac-medium.onnx

# Storage
DATA_DIR=./data

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173

# Agent / tools (macOS system actions)
TOOLS_ENABLED=true
TOOLS_MAX_ITERS=5
# Apps the agent may launch via open_app (everything else is rejected)
OPEN_APP_ALLOWLIST=Calculator,Notes,Safari,Music,Calendar,Reminders,Maps

# iMessage sending (set false to disable the send_imessage tool)
IMESSAGE_ENABLED=true
CONTACTS_MAX_RESULTS=5
# Applied to spoken/national-format numbers so they resolve (e.g. +82 turns
# "010 1234 5678" into +821012345678). Leave empty to send numbers as dialed.
DEFAULT_COUNTRY_CODE=
